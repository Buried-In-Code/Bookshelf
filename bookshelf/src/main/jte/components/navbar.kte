@import duckpond.buriedincode.database.User
@param session: User?
@param users: List<User>

<nav class="navbar is-primary is-fixed-top" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a class="navbar-item" href="/">
      <img src="/static/img/logo.png" alt="Bookshelf Logo">
      Bookshelf
    </a>
    <span class="navbar-burger burger has-text-primary-invert" data-target="navMenu">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </div>
  <div class="navbar-menu" id="navMenu">
    <div class="navbar-start">
      <a class="navbar-item" href="/search">Search</a>
      <div class="navbar-item has-dropdown is-hoverable">
        <a class="navbar-link">Browse</a>
        <div class="navbar-dropdown">
          <a class="navbar-item" href="/books">Books</a>
          <a class="navbar-item" href="/series">Series</a>
          <a class="navbar-item" href="/users">Users</a>
        </div>
      </div>
    </div>
    <div class="navbar-end">
      <div class="navbar-item">
        <div class="select is-primary">
          <select id="user-selector" name="userId" onchange="selectUser()">
            <option value="guest" selected="${ session == null }">Guest</option>
            @for(user in users)
              <option value="${ user.id.value }" selected="${ session?.id?.value == user.id.value }">${ user.username }</option>
            @endfor
          </select>
        </div>
      </div>
    </div>
  </div>
</nav>
