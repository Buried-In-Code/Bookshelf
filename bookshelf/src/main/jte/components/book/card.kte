@import duckpond.buriedincode.Utils.toHumanReadable
@import duckpond.buriedincode.database.Book
@import duckpond.buriedincode.database.User
@import kotlinx.datetime.TimeZone
@import kotlinx.datetime.minus
@import kotlinx.datetime.toLocalDateTime
@import kotlinx.datetime.DateTimeUnit
@import kotlin.time.Clock
@import kotlin.time.ExperimentalTime
@param entry: Book
@param user: User?
@param extras: String? = null

!{ @OptIn(ExperimentalTime::class) val today = Clock.System.now().toLocalDateTime(TimeZone.currentSystemDefault()).date }
!{ val releaseDate = entry.publishDate ?: today.minus(15, DateTimeUnit.DAY) }
!{ val isReleased = releaseDate <= today }
!{ val isWished = user?.wishedBooks?.any { it.book.id.value == entry.id.value } ?: false }
!{ val isRead = user?.readBooks?.any { it.book.id.value == entry.id.value } ?: false }
!{ val readDate = user?.readBooks?.firstOrNull { it.book.id.value == entry.id.value }?.date }

<a class="card book-card" href="/books/${ entry.id.value }">
  <div class="card-image">
    <figure class="image is-2by3">
      <img class="@if(!isReleased)greyscale@endif" loading="lazy" src="/books/${ entry.id.value }/image" alt="Cover of ${ entry.title }" />
      @if(isRead)
        <span class="tag is-info book-card-badge">${ readDate?.toHumanReadable() ?: "Read" }</span>
      @endif
    </figure>
  </div>

  <div class="card-content is-flex is-flex-direction-column is-flex-grow-1">
    <p class="title is-6 book-card-title mb-1">${ entry.title }</p>
    @if(extras != null)
      <p class="has-text-centered is-size-7 has-text-grey mt-auto">${ extras }</p>
    @endif
  </div>

  @if(user != null)
    <footer class="card-footer">
      @if(!entry.isCollected)
        <button class="card-footer-item button is-ghost@if(isWished) has-text-success@else has-text-text@endif" title="@if(isWished)Unwish@else Wish@endif" onclick="toggleWished(event, this, ${ entry.id.value }, ${ isWished });">
          <span class="icon">
            <i class="@if(isWished)fa-solid@else fa-regular@endif fa-star"></i>
          </span>
        </button>
      @endif

      <button class="card-footer-item button is-ghost@if(entry.isCollected) has-text-success@else has-text-text@endif" title="@if(entry.isCollected)Discard@else Collect@endif" onclick="toggleCollected(event, this, ${ entry.id.value }, ${ entry.isCollected });">
        <span class="icon">
          <i class="fa-solid @if(entry.isCollected)fa-box@else fa-box-open@endif"></i>
        </span>
      </button>

      @if(entry.isCollected)
        <button class="card-footer-item button is-ghost@if(isRead) has-text-success@else has-text-text@endif" title="@if(isRead)Unread@else Mark Read@endif" onclick="toggleRead(event, this, ${ entry.id.value }, ${ isRead });">
          <span class="icon">
            <i class="@if(isRead)fa-solid@else fa-regular@endif fa-bookmark"></i>
          </span>
        </button>
      @endif
    </footer>
  @endif
</a>
