@import duckpond.buriedincode.Utils.toHumanReadable
@import duckpond.buriedincode.database.Book
@import duckpond.buriedincode.database.BookSeries
@import duckpond.buriedincode.database.User
@import gg.jte.support.ForSupport
@param session: User?
@param users: List<User>
@param resource: Book

!{ val isWished = session?.wishedBooks?.any { it.book.id.value == resource.id.value } ?: false }
!{ val readEntry = session?.readBooks?.find { it.book.id.value == resource.id.value } }
!{ val isCollected = resource.isCollected }

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <title>Bookshelf</title>
  <link href="https://use.fontawesome.com/releases/v7.2.0/css/all.css" rel="stylesheet">
  <link href="/static/css/bulma-custom.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body class="has-navbar-fixed-top">
  @template.components.navbar(session = session, users = users)

  <main>
    <%-- Hero banner with title --%>
    <section class="hero is-small has-background-primary-soft has-text-primary-soft-invert">
      <div class="hero-body">
        <div class="container has-text-centered">
          <h1 class="title is-2">${ resource.title }</h1>
          @if(!resource.authors.empty())
            <p class="subtitle is-5">
              ${ resource.authors.map { it.author.name }.joinToString(" · ") }
            </p>
          @endif
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">

        <%-- Main two-column layout --%>
        <div class="columns is-variable is-6">

          <%-- Left column: cover + actions --%>
          <div class="column is-one-third-tablet is-one-quarter-fullhd">

            <%-- Book cover --%>
            <div class="card mb-4">
              <div class="card-image">
                <figure class="image is-2by3">
                  <img loading="lazy" src="/books/${ resource.id.value }/image" alt="Cover of ${ resource.title }"/>
                </figure>
              </div>
            </div>

            <%-- Action buttons (logged-in users only) --%>
            @if(session != null)
              <div class="card">
                <div class="card-content">
                  <div class="buttons is-centered">
                    @if(!isCollected)
                      <button class="button@if(isWished) is-success@else is-light@endif" onclick="toggleWished(event, this, ${ resource.id.value }, ${ isWished });">
                        <span class="icon">
                          <i class="@if(isWished)fa-solid@else fa-regular@endif fa-star"></i>
                        </span>
                        <span>@if(isWished)Unwish@else Wish@endif</span>
                      </button>
                    @endif

                    <button class="button@if(isCollected) is-success@else is-light@endif" onclick="toggleCollected(event, this, ${ resource.id.value }, ${ isCollected });">
                      <span class="icon">
                        <i class="fa-solid @if(isCollected)fa-box@else fa-box-open@endif"></i>
                      </span>
                      <span>@if(isCollected)Discard@else Collect@endif</span>
                    </button>

                    @if(isCollected)
                      <button class="button@if(readEntry != null) is-success@else is-light@endif" onclick="toggleRead(event, this, ${ resource.id.value }, ${ readEntry != null });">
                        <span class="icon">
                          <i class="@if(readEntry != null)fa-solid@else fa-regular@endif fa-bookmark"></i>
                        </span>
                        <span>@if(readEntry != null)Unread@else Mark Read@endif</span>
                      </button>
                    @endif
                  </div>

                  @if(readEntry != null)
                    <hr class="my-3">
                    <p class="has-text-centered is-size-7">
                      <span class="has-text-weight-semibold">Read on:</span>
                      ${ readEntry!!.date?.toHumanReadable() ?: "Date unknown" }
                    </p>
                  @endif
                </div>
              </div>
            @endif
          </div>

          <%-- Right column: details --%>
          <div class="column">

            <%-- Edit button --%>
            @if(session != null)
              <div class="is-flex is-justify-content-flex-end mb-4">
                <a href="/books/${ resource.id.value }/edit" class="button is-warning is-light">
                  <span class="icon">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </span>
                  <span>Edit</span>
                </a>
              </div>
            @endif

            <%-- Summary --%>
            @if(resource.summary != null)
              <div class="card mb-5">
                <div class="card-header">
                  <p class="card-header-title">Summary</p>
                </div>
                <div class="card-content">
                  <div class="content">
                    <p>$unsafe{ resource.summary?.replace("\n", "<br />") }</p>
                  </div>
                </div>
              </div>
            @endif

            <%-- Book metadata --%>
            <div class="card">
              <div class="card-header">
                <p class="card-header-title">Details</p>
              </div>
              <div class="card-content">
                <table class="table is-fullwidth is-striped">
                  <tbody>
                    <tr>
                      <th class="is-narrow">Authors</th>
                      <td>${ resource.authors.map { it.author.name }.joinToString(", ").ifEmpty { "—" } }</td>
                    </tr>
                    <tr>
                      <th>Format</th>
                      <td>${ resource.format ?: "—" }</td>
                    </tr>
                    <tr>
                      <th>ISBN</th>
                      <td>${ resource.isbn }</td>
                    </tr>
                    <tr>
                      <th>Published</th>
                      <td>${ resource.publishDate?.toHumanReadable() ?: "—" }</td>
                    </tr>
                    <tr>
                      <th>Publisher</th>
                      <td>${ resource.publisher ?: "—" }</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <%-- Series sections --%>
        @for(series in resource.series)
          <div class="mt-6">
            <div class="is-flex is-align-items-baseline mb-3" style="gap: 0.75rem">
              <h2 class="title is-4 mb-0">${ series.series.title } Series</h2>
            </div>

            <div class="scrolling-wrapper pb-3">
              <div class="auto-grid">
                @for(entry in series.series.books.sortedWith(compareBy<BookSeries> ({ it.index.toIntOrNull() ?: Int.MAX_VALUE }, { it.book.title })).reversed())
                  @template.components.book.card(entry = entry.book, user = session, extras = "Book #${ entry.index ?: "—" }")
                @else
                  <div class="notification is-warning is-light">
                    No books in this series yet.
                  </div>
                @endfor
              </div>
            </div>
          </div>
        @endfor

      </div>
    </section>
  </main>

  @template.components.footer()
  <script src="/static/js/scripts.js" type="text/javascript"></script>
  <script src="/static/js/bulma-navbar.js" type="text/javascript"></script>
  <script src="/static/js/bulma-theme.js" type="text/javascript"></script>
  <script type="text/javascript">
    async function toggleWished(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "wish": nextState
      };
      if (nextState) {
        payload.collect = false;
        payload.read = false;
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }

    async function toggleCollected(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "collect": nextState
      };
      if (nextState) {
        payload.wish = false;
      } else {
        payload.read = false;
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }

    async function toggleRead(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "read": nextState
      };
      if (nextState) {
        payload.collect = true;
        payload.wish = false;
        payload.readDate = "today";
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }
  </script>
</body>
</html>
