@import duckpond.buriedincode.database.Book
@import duckpond.buriedincode.database.Series
@import duckpond.buriedincode.database.User
@param session: User
@param users: List<User>
@param resource: Book
@param seriesOptions: List<Series>

!{ val attachedSeriesIds = resource.series.map { it.series.id.value }.toSet() }
!{ val readEntry = session.readBooks.find { it.book.id.value == resource.id.value } }

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <title>Bookshelf</title>
  <link href="https://use.fontawesome.com/releases/v6.3.0/css/all.css" rel="stylesheet">
  <link href="/static/css/bulma-custom.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body class="has-navbar-fixed-top">
  @template.components.navbar(session = session, users = users)
  <main class="section">
    <header class="block has-text-centered">
      <h1 class="title is-1">Edit Book</h1>
    </header>
    <div class="container">
      <div class="columns">
        <div class="column is-one-third-tablet is-one-quarter-fullhd">
          <figure class="image is-2by3">
            <img loading="lazy" src="/books/${ resource.id.value }/image"/>
          </figure>
          <div class="notification is-info mt-4 has-text-centered">Cover editing will be added later.</div>
        </div>
        <div class="column">
          <div class="box has-background-text-soft is-shadowless">
            <form id="book-edit-form" onsubmit="return false;">
              <div class="field">
                <label class="label has-text-info-bold" for="title">Title</label>
                <div class="control">
                  <input class="input" id="title" name="title" type="text" value="${ resource.title }">
                </div>
              </div>
              <div class="columns is-multiline is-centered">
                <div class="column is-half">
                  <div class="field">
                    <label class="label has-text-info-bold" for="format">Format</label>
                    <div class="control">
                      <input class="input" id="format" name="format" type="text" value="${ resource.format ?: "" }">
                    </div>
                  </div>
                </div>
                <div class="column is-half">
                  <div class="field">
                    <label class="label has-text-info-bold" for="isbn">ISBN</label>
                    <div class="control">
                      <input class="input" id="isbn" name="isbn" type="text" value="${ resource.isbn }">
                    </div>
                  </div>
                </div>
                <div class="column is-half">
                  <div class="field">
                    <label class="label has-text-info-bold" for="publishDate">Publish Date</label>
                    <div class="control">
                      <input class="input" id="publishDate" name="publishDate" type="date" value="${ resource.publishDate?.toString() ?: "" }">
                    </div>
                  </div>
                </div>
                <div class="column is-half">
                  <div class="field">
                    <label class="label has-text-info-bold" for="publisher">Publisher</label>
                    <div class="control">
                      <input class="input" id="publisher" name="publisher" type="text" value="${ resource.publisher ?: "" }">
                    </div>
                  </div>
                </div>
                @if(readEntry != null)
                  <div class="column is-half">
                    <div class="field">
                      <label class="label has-text-info-bold" for="readDate">Read Date</label>
                      <div class="control">
                        <input class="input" id="readDate" name="readDate" type="date" value="${ readEntry!!.date?.toString() ?: "" }">
                      </div>
                    </div>
                  </div>
                @endif
              </div>
              <div class="field">
                <label class="label has-text-info-bold" for="authors">Authors</label>
                <div class="control">
                  <input class="input" disabled id="authors" name="authors" type="text" value="${ resource.authors.map { it.author.name }.joinToString(", ") }">
                </div>
                <p class="help">Author editing will be added later.</p>
              </div>
              <div class="field">
                <label class="label has-text-info-bold" for="summary">Summary</label>
                <div class="control">
                  <textarea class="textarea" id="summary" name="summary">${ resource.summary?.replace("<br />", "\n")?.replace("&amp;", "&") }</textarea>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="box has-background-text-soft is-shadowless">
        <h3 class="title is-4 has-text-centered">Series</h3>
        <div class="table-container">
          <table class="table is-striped is-fullwidth">
            <thead>
              <tr>
                <th colspan="3" class="has-text-centered">Series title</th>
                <th class="has-text-centered">Index</th>
                <th class="has-text-centered">Remove?</th>
              </tr>
            </thead>
            <tbody>
              @for(seriesEntry in resource.series.sortedBy { it.series.title })
                <tr class="series-row" data-series-id="${ seriesEntry.id.value }">
                  <td colspan="3">
                    <div class="control">
                      <input class="input" disabled type="text" value="${ seriesEntry.series.title }">
                    </div>
                  </td>
                  <td>
                    <div class="control">
                      <input class="input series-index" type="text" value="${ seriesEntry.index }">
                    </div>
                  </td>
                  <td>
                    <div class="control has-text-centered">
                      <input class="series-remove" type="checkbox">
                    </div>
                  </td>
                </tr>
              @endfor
            </tbody>
            <tfoot>
              <tr>
                <th colspan="3">
                  <div class="control">
                    <div class="select is-fullwidth">
                      <select id="newSeriesId" name="newSeriesId">
                        <option value="">Select a series...</option>
                        @for(seriesOption in seriesOptions.sorted())
                          @if(!attachedSeriesIds.contains(seriesOption.id.value))
                            <option value="${ seriesOption.id.value }">${ seriesOption.title }</option>
                          @endif
                        @endfor
                      </select>
                    </div>
                  </div>
                </th>
                <th>
                  <div class="control">
                    <input class="input" id="newSeriesIndex" name="newSeriesIndex" type="text">
                  </div>
                </th>
                <th></th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
      <div class="buttons is-centered">
        <button class="button is-primary" id="save-book-button" onclick="saveBookChanges()">
          <span class="icon">
            <i class="fa-solid fa-floppy-disk"></i>
          </span>
          <span>Save Changes</span>
        </button>
        <a class="button is-light" href="/books/${ resource.id.value }">Cancel</a>
      </div>
    </div>
  </main>
  @template.components.footer()
  <script src="/static/js/scripts.js" type="text/javascript"></script>
  <script src="/static/js/bulma-navbar.js" type="text/javascript"></script>
  <script src="/static/js/bulma-theme.js" type="text/javascript"></script>
  <script type="text/javascript">
    async function saveBookChanges() {
      const caller = "save-book-button";
      addLoading(caller);
      const payload = {
        "title": document.getElementById("title").value,
        "summary": document.getElementById("summary").value,
        "format": document.getElementById("format").value,
        "isbn": document.getElementById("isbn").value,
        "publishDate": document.getElementById("publishDate").value,
        "publisher": document.getElementById("publisher").value,
        @if(readEntry != null)
          "readDate": document.getElementById("readDate").value,
        @endif
      };
      const seriesUpdates = [];
      document.querySelectorAll(".series-row").forEach((row) => {
        seriesUpdates.push({
          "seriesId": Number(row.dataset.seriesId),
          "index": row.querySelector(".series-index").value,
          "remove": row.querySelector(".series-remove").checked,
        });
      });
      const newSeriesId = document.getElementById("newSeriesId").value;
      const newSeriesIndex = document.getElementById("newSeriesIndex").value;
      if (newSeriesId !== "") {
        if (newSeriesIndex.trim() === "") {
          alert("Please provide the series index for the new series link.");
          removeLoading(caller);
          return;
        }
        seriesUpdates.push({
          "seriesId": Number(newSeriesId),
          "index": newSeriesIndex,
        });
      }
      payload["series"] = seriesUpdates;
      const response = await submitRequest("/api/books/${ resource.id.value }", "PATCH", payload);
      if (response !== null) {
        window.location = "/books/${ resource.id.value }";
      }
      removeLoading(caller);
    }
  </script>
</body>
</html>
