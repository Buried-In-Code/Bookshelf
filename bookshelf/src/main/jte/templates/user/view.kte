@import duckpond.buriedincode.Utils.toHumanReadable
@import duckpond.buriedincode.database.Book
@import duckpond.buriedincode.database.ReadBook
@import duckpond.buriedincode.database.User
@import gg.jte.support.ForSupport
@param session: User?
@param users: List<User>
@param resource: User
@param nextBooks: List<Book>

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <title>Bookshelf</title>
  <link href="https://use.fontawesome.com/releases/v6.3.0/css/all.css" rel="stylesheet">
  <link href="/static/css/bulma-custom.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body class="has-navbar-fixed-top">
  @template.components.navbar(session = session, users = users)
  <main class="section">
    <header class="block has-text-centered">
      <h1 class="title is-1">${ resource.username }</h1>
    </header>
    <div class="container">
      <div class="box has-background-text-soft">
        <nav class="level is-mobile">
          <div class="level-item has-text-centered">
            <div>
              <p class="title">Wished</p>
              <p class="heading">${ resource.wishedBooks.count() }</p>
            </div>
          </div>
          <div class="level-item has-text-centered">
            <div>
              <p class="title">Collected</p>
              <p class="heading">${ resource.collected.count() }</p>
            </div>
          </div>
          <div class="level-item has-text-centered">
            <div>
              <p class="title">Read</p>
              <p class="heading">${ resource.readBooks.count() }</p>
            </div>
          </div>
        </nav>
      </div>
      <nav class="level is-mobile">
        <div class="level-left has-text-centered">
          <div>
            <p class="title mt-3 mb-0">Up Next</p>
            <p class="heading mt-0"></p>
          </div>
        </div>
      </nav>
      <div class="scrolling-wrapper">
        <div class="auto-grid">
          @for(entry in ForSupport.of(nextBooks.sorted().take(10)))
            @template.components.book.card(entry = entry.get(), user = session)
          @else
            <div class="box has-background-text-soft is-shadowless has-text-centered" style="width: 100%">
              <h5 class="title is-5 has-text-danger">No books read yet.</h5>
            </div>
          @endfor
        </div>
      </div>
      <nav class="level is-mobile">
        <div class="level-left has-text-centered">
          <div>
            <p class="title mt-3 mb-0">Last Read</p>
            <p class="heading mt-0"></p>
          </div>
        </div>
      </nav>
      <div class="scrolling-wrapper">
        <div class="auto-grid">
          @for(entry in ForSupport.of(resource.readBooks.sortedWith(compareBy<ReadBook> { it.date }.reversed().thenBy{ it.book }).take(10)))
            @template.components.book.card(entry = entry.get().book, user = session)
          @else
            <div class="box has-background-text-soft is-shadowless has-text-centered" style="width: 100%">
              <h5 class="title is-5 has-text-danger">No books read yet.</h5>
            </div>
          @endfor
        </div>
      </div>
    </div>
  </main>
  @template.components.footer()
  <script src="/static/js/scripts.js" type="text/javascript"></script>
  <script src="/static/js/bulma-navbar.js" type="text/javascript"></script>
  <script src="/static/js/bulma-theme.js" type="text/javascript"></script>
</body>
</html>
