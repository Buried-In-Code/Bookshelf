@import duckpond.buriedincode.Utils.toHumanReadable
@import duckpond.buriedincode.database.Book
@import duckpond.buriedincode.database.ReadBook
@import duckpond.buriedincode.database.User
@import gg.jte.support.ForSupport
@param session: User?
@param users: List<User>
@param resource: User
@param nextBooks: List<Book>

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <title>Bookshelf</title>
  <link href="https://use.fontawesome.com/releases/v7.2.0/css/all.css" rel="stylesheet">
  <link href="/static/css/bulma-custom.css" rel="stylesheet">
  <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body class="has-navbar-fixed-top">
  @template.components.navbar(session = session, users = users)

  <main>
    <%-- Hero banner --%>
    <section class="hero is-small has-background-primary-soft has-text-primary-soft-invert">
      <div class="hero-body">
        <div class="container has-text-centered">
          <h1 class="title is-2">${ resource.username }</h1>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">

        <%-- Stats row --%>
        <div class="columns is-mobile mb-6">
          <div class="column">
            <div class="card has-text-centered">
              <div class="card-content">
                <p class="heading">Wished</p>
                <p class="title is-3">${ resource.wishedBooks.count() }</p>
              </div>
            </div>
          </div>
          <div class="column">
            <div class="card has-text-centered">
              <div class="card-content">
                <p class="heading">Collected</p>
                <p class="title is-3">${ resource.collected.count() }</p>
              </div>
            </div>
          </div>
          <div class="column">
            <div class="card has-text-centered">
              <div class="card-content">
                <p class="heading">Read</p>
                <p class="title is-3">${ resource.readBooks.count() }</p>
              </div>
            </div>
          </div>
        </div>

        <%-- Up Next --%>
        <div class="mt-5">
          <div class="is-flex is-align-items-baseline mb-3" style="gap: 0.75rem">
            <h2 class="title is-4 mb-0">Up Next</h2>
          </div>
          <div class="scrolling-wrapper pb-3">
            <div class="auto-grid">
              @for(entry in ForSupport.of(nextBooks.sorted().take(10)))
                @template.components.book.card(entry = entry.get(), user = session)
              @else
                <div class="notification is-warning is-light">
                  No upcoming books yet.
                </div>
              @endfor
            </div>
          </div>
        </div>

        <%-- Last Read --%>
        <div class="mt-6">
          <div class="is-flex is-align-items-baseline mb-3" style="gap: 0.75rem">
            <h2 class="title is-4 mb-0">Last Read</h2>
          </div>
          <div class="scrolling-wrapper pb-3">
            <div class="auto-grid">
              @for(entry in ForSupport.of(resource.readBooks.sortedWith(compareBy<ReadBook> { it.date }.reversed().thenBy { it.book }).take(10)))
                @template.components.book.card(entry = entry.get().book, user = session)
              @else
                <div class="notification is-warning is-light">
                  No books read yet.
                </div>
              @endfor
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  @template.components.footer()
  <script src="/static/js/scripts.js" type="text/javascript"></script>
  <script src="/static/js/bulma-navbar.js" type="text/javascript"></script>
  <script src="/static/js/bulma-theme.js" type="text/javascript"></script>
  <script type="text/javascript">
    async function toggleWished(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "wish": nextState
      };
      if (nextState) {
        payload.collect = false;
        payload.read = false;
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }
    async function toggleCollected(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "collect": nextState
      };
      if (nextState) {
        payload.wish = false;
      } else {
        payload.read = false;
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }
    async function toggleRead(event, caller, id, currentState) {
      event.stopPropagation();
      event.preventDefault();
      addLoading(caller);
      const nextState = !currentState;
      const payload = {
        "read": nextState
      };
      if (nextState) {
        payload.collect = true;
        payload.wish = false;
        payload.readDate = "today";
      }
      @raw
        const response = await submitRequest(`/api/books/${id}`, "POST", payload);
      @endraw
      if (response !== null) {
        window.location.reload();
      }
      removeLoading(caller);
    }
  </script>
</body>
</html>
